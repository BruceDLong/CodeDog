//############  Add GUI-Toolkit features using GTK3
requirements = [
    [tagOneOf, Platform, [MacOS]]
]

interface={
    provides=[GUI_ToolKit_implementation]
    libFiles=[``]
    headers=[AppKit]
}

LibDescription ={
    useStatus   = dynamic
    description ='AppKit is a GUI Toolkit'
    features    =[GUI_ToolKit, Mouse, Keyboard, Audio]
    platforms   =[MacOS]
    bindings    =[Swift]
}

initCode = ``

embedVeryHigh = `
var CodeDogAppDelegate: AppDelegate?
var CodeDogCurrentEventView: NSView?
var CodeDogCurrentPaintRect: CGRect = .zero
var CodeDogImageCache: [String: NSImage] = [:]
var CodeDogCurrentTextColor: NSColor = .black

func CodeDogMarkViewTreeNeedsDisplay(_ view: NSView) {
    view.needsDisplay = true
    for child in view.subviews {
        CodeDogMarkViewTreeNeedsDisplay(child)
    }
}

func CodeDogDisplayViewTree(_ view: NSView) {
    CodeDogMarkViewTreeNeedsDisplay(view)
    view.layoutSubtreeIfNeeded()
    view.displayIfNeeded()
}

func CodeDogFitScrollDocument(_ scrollView: NSScrollView) {
    guard let document = scrollView.documentView else { return }
    var frame = document.frame
    frame.origin = .zero
    frame.size.width = max(frame.size.width, scrollView.contentSize.width)
    document.frame = frame
    CodeDogMarkViewTreeNeedsDisplay(document)
}

class CodeDogRootView: NSView {
    var codeDogFixedSubviews: [(view: NSView, height: CGFloat)] = []
    var codeDogExpandingSubviews: [NSView] = []

    func addCodeDogSubview(_ widget: NSView, expand: Bool) {
        if widget.superview !== self {
            addSubview(widget)
        }
        codeDogFixedSubviews.removeAll { $0.view === widget }
        codeDogExpandingSubviews.removeAll { $0 === widget }
        if expand {
            codeDogExpandingSubviews.append(widget)
        } else {
            codeDogFixedSubviews.append((view: widget, height: widget.frame.size.height))
        }
        layoutCodeDogSubviews()
        needsLayout = true
    }

    func layoutCodeDogSubviews() {
        let width = bounds.size.width
        var topY = bounds.size.height
        let expandingCount = max(codeDogExpandingSubviews.count, 1)
        let fixedHeight = codeDogFixedSubviews.reduce(CGFloat(0)) { $0 + $1.height }
        let expandingHeight = max(0, bounds.size.height - fixedHeight) / CGFloat(expandingCount)
        var expandingY: CGFloat = 0
        for widget in codeDogExpandingSubviews {
            widget.frame = NSRect(x: 0, y: expandingY, width: width, height: expandingHeight)
            CodeDogMarkViewTreeNeedsDisplay(widget)
            expandingY += expandingHeight
        }
        for item in codeDogFixedSubviews {
            topY -= item.height
            item.view.frame = NSRect(x: 0, y: topY, width: width, height: item.height)
            if let scrollView = item.view as? NSScrollView {
                CodeDogFitScrollDocument(scrollView)
            }
            CodeDogMarkViewTreeNeedsDisplay(item.view)
        }
    }

    override func layout() {
        super.layout()
        layoutCodeDogSubviews()
    }

    override func setFrameSize(_ newSize: NSSize) {
        super.setFrameSize(newSize)
        layoutCodeDogSubviews()
    }
}

func CodeDogAddToContainer(_ container: NSView, _ widget: NSView, _ expand: Bool) {
    if let scrollView = container as? NSScrollView {
        widget.frame.origin = .zero
        scrollView.documentView = widget
        CodeDogFitScrollDocument(scrollView)
        CodeDogMarkViewTreeNeedsDisplay(widget)
        return
    }
    if let root = container as? CodeDogRootView {
        root.addCodeDogSubview(widget, expand: expand)
        return
    }
    if widget.superview !== container {
        container.addSubview(widget)
    }
    if expand {
        widget.frame = container.bounds
        widget.autoresizingMask = [.width, .height]
    }
    CodeDogMarkViewTreeNeedsDisplay(widget)
}

func CodeDogControlEvent() -> NSEvent {
    return NSApplication.shared.currentEvent ?? NSEvent()
}

func CodeDogResolveImagePath(_ filename: String) -> String? {
    let fileManager = FileManager.default
    let rawPath = (filename as NSString).expandingTildeInPath
    let basename = (rawPath as NSString).lastPathComponent
    let name = (basename as NSString).deletingPathExtension
    let ext = (basename as NSString).pathExtension
    var candidates: [String] = []

    if (rawPath as NSString).isAbsolutePath {
        candidates.append(rawPath)
    } else {
        candidates.append(rawPath)
        candidates.append("./assets/" + rawPath)
        candidates.append("./assets/" + basename)
        candidates.append("../../Examples/Resources/" + basename)
        candidates.append("../Examples/Resources/" + basename)
        candidates.append("./Examples/Resources/" + basename)
    }

    for candidate in candidates {
        let resolved = URL(fileURLWithPath: candidate).standardizedFileURL.path
        if fileManager.fileExists(atPath: resolved) {
            return resolved
        }
    }

    if let bundlePath = Bundle.main.path(forResource: name, ofType: ext.isEmpty ? nil : ext) {
        return bundlePath
    }
    return nil
}

func CodeDogLoadImage(_ filename: String) -> NSImage? {
    guard let path = CodeDogResolveImagePath(filename) else {
        return nil
    }
    if let cached = CodeDogImageCache[path] {
        return cached
    }
    guard let image = NSImage(contentsOfFile: path) else {
        return nil
    }
    CodeDogImageCache[path] = image
    return image
}

func CodeDogFont(_ font: fontSpec) -> NSFont {
    if let namedFont = NSFont(name: font.name, size: CGFloat(font.size)) {
        return namedFont
    }
    return NSFont.systemFont(ofSize: CGFloat(font.size))
}

func CodeDogSetContextColor(_ cr: CGContext!, _ red: Double, _ green: Double, _ blue: Double, _ alpha: Double) {
    let color = NSColor(red: CGFloat(red)/255.0, green: CGFloat(green)/255.0, blue: CGFloat(blue)/255.0, alpha: CGFloat(alpha)/255.0)
    CodeDogCurrentTextColor = color
    cr.setFillColor(color.cgColor)
    cr.setStrokeColor(color.cgColor)
}

func CodeDogSetContextCdColor(_ cr: CGContext!, _ color: cdColor) {
    CodeDogSetContextColor(cr, Double(color.red), Double(color.green), Double(color.blue), Double(color.alpha))
}

class CodeDogButton: NSButton {
    weak var codeDogWidget: widget?

    convenience init(title: String) {
        self.init(frame: .zero)
        self.title = title
        self.bezelStyle = .rounded
        self.target = self
        self.action = #selector(codeDogClicked(_:))
    }

    @objc func codeDogClicked(_ sender: Any?) {
        _ = codeDogWidget?.primaryClick(CodeDogControlEvent())
    }
}

class CodeDogTextField: NSTextField, NSTextFieldDelegate {
    weak var codeDogWidget: widget?

    convenience init(text: String) {
        self.init(frame: .zero)
        self.stringValue = text
        self.isEditable = true
        self.isSelectable = true
        self.delegate = self
    }

    func controlTextDidChange(_ obj: Notification) {
        _ = codeDogWidget?.keyTyped(CodeDogControlEvent())
    }
}

class CodeDogListBox: NSScrollView, NSTableViewDataSource, NSTableViewDelegate {
    weak var codeDogWidget: widget?
    let tableView = NSTableView()
    var items: [String] = []

    override init(frame frameRect: NSRect) {
        super.init(frame: frameRect)
        configure()
    }

    required init?(coder: NSCoder) {
        super.init(coder: coder)
        configure()
    }

    func configure() {
        hasVerticalScroller = true
        hasHorizontalScroller = false
        autohidesScrollers = false
        drawsBackground = true
        borderType = .bezelBorder

        tableView.headerView = nil
        tableView.usesAlternatingRowBackgroundColors = true
        tableView.allowsMultipleSelection = false
        tableView.delegate = self
        tableView.dataSource = self
        tableView.target = self
        tableView.doubleAction = #selector(codeDogDoubleClicked(_:))

        let column = NSTableColumn(identifier: NSUserInterfaceItemIdentifier("CodeDogListColumn"))
        column.resizingMask = .autoresizingMask
        tableView.addTableColumn(column)
        documentView = tableView
        updateTableFrame()
    }

    override func setFrameSize(_ newSize: NSSize) {
        super.setFrameSize(newSize)
        updateTableFrame()
    }

    func updateTableFrame() {
        let height = max(contentSize.height, CGFloat(max(items.count, 1)) * tableView.rowHeight)
        tableView.frame = NSRect(x: 0, y: 0, width: contentSize.width, height: height)
        if let column = tableView.tableColumns.first {
            column.width = contentSize.width
        }
    }

    func addItem(_ text: String) {
        items.append(text)
        tableView.reloadData()
        updateTableFrame()
    }

    func clearItems() {
        items.removeAll()
        tableView.deselectAll(nil)
        tableView.reloadData()
        updateTableFrame()
    }

    func setSelectedIndex(_ index: Int) {
        if index >= 0 && index < items.count {
            tableView.selectRowIndexes(IndexSet(integer: index), byExtendingSelection: false)
            tableView.scrollRowToVisible(index)
        } else {
            tableView.deselectAll(nil)
        }
    }

    func selectedIndex() -> Int {
        return tableView.selectedRow
    }

    func selectedText() -> String {
        let index = selectedIndex()
        if index >= 0 && index < items.count {
            return items[index]
        }
        return ""
    }

    func numberOfRows(in tableView: NSTableView) -> Int {
        return items.count
    }

    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
        let identifier = NSUserInterfaceItemIdentifier("CodeDogListCell")
        let cell = (tableView.makeView(withIdentifier: identifier, owner: self) as? NSTextField) ?? NSTextField(labelWithString: "")
        cell.identifier = identifier
        cell.stringValue = items[row]
        cell.lineBreakMode = .byTruncatingTail
        return cell
    }

    func tableViewSelectionDidChange(_ notification: Notification) {
        if selectedIndex() >= 0 {
            _ = codeDogWidget?.primaryClick(CodeDogControlEvent())
        }
    }

    @objc func codeDogDoubleClicked(_ sender: Any?) {
        if selectedIndex() >= 0 {
            _ = codeDogWidget?.primaryDblClick(CodeDogControlEvent())
        }
    }
}

extension NSEvent {
    private var codeDogPointInEventView: NSPoint {
        if let view = CodeDogCurrentEventView {
            return view.convert(locationInWindow, from: nil)
        }
        if let view = window?.contentView {
            return view.convert(locationInWindow, from: nil)
        }
        return locationInWindow
    }

    var x: Int { Int(codeDogPointInEventView.x) }
    var y: Int { Int(codeDogPointInEventView.y) }
    var keyval: UInt {
        if let scalar = charactersIgnoringModifiers?.unicodeScalars.first {
            return UInt(scalar.value)
        }
        return UInt(keyCode)
    }
    var state: UInt { UInt(modifierFlags.rawValue) }
}

// APP DELEGATE /////////////////////////////////////////////////////
class AppDelegate: NSObject, NSApplicationDelegate {
    func applicationDidFinishLaunching(_ aNotification: Notification) {
        NSApplication.shared.setActivationPolicy(.regular)
        window = NSWindow(contentRect: NSMakeRect(0, 0, 1280, 800),
            styleMask: [.titled, .closable, .miniaturizable, .resizable],
            backing: .buffered,
            defer: false)
        window.title = "CodeDog"
        window.acceptsMouseMovedEvents = true
        window.center()
        window.contentViewController = ViewController()
        window.makeKeyAndOrderFront(nil)
        if let contentView = window.contentView {
            CodeDogDisplayViewTree(contentView)
        }
        NSApplication.shared.activate(ignoringOtherApps: true)
    }
}
// VIEW CONTROLLER ///////////////////////////////////////////////
class ViewController: NSViewController {
    override func viewDidLoad() {
        super.viewDidLoad()
    }
    override func loadView() {
        self.view = CodeDogRootView(frame: NSRect(x: 0, y: 0, width: 1280, height: 800))
        thisApp.gui.frame = self.view
        thisApp.createAppArea(self.view)
    }
}

class CanvasView: NSView{
    var cr: CGContext!
    var parent: DashboardWidget!
    var scaleFactor: Double = 1
    override var isFlipped: Bool { true }
    override init(frame frameRect: NSRect) {
        super.init(frame: frameRect)
        wantsLayer = true
        layerContentsRedrawPolicy = .onSetNeedsDisplay
        needsDisplay = true
    }
    required init?(coder decoder: NSCoder) {
        super.init(coder: decoder)
        wantsLayer = true
        layerContentsRedrawPolicy = .onSetNeedsDisplay
        needsDisplay = true
    }
    override func draw(_ dirtyRect: NSRect) -> Void{
        super.draw(dirtyRect)
        cr = NSGraphicsContext.current?.cgContext
        cr.saveGState()
        cr.clip(to: bounds)
        CodeDogCurrentPaintRect = bounds
        CodeDogCurrentEventView = self
        parent.EventDispatcher.topWidget.draw(cr)
        cr.restoreGState()
    }
    func setParent(_ wid: DashboardWidget!) -> Void{
        var wid = wid
        parent = wid;
        needsDisplay = true
    }
    override func viewDidMoveToSuperview() {
        super.viewDidMoveToSuperview()
        needsDisplay = true
    }
    override func viewDidMoveToWindow() {
        super.viewDidMoveToWindow()
        window?.makeFirstResponder(self)
        needsDisplay = true
    }
    override func setFrameSize(_ newSize: NSSize) {
        super.setFrameSize(newSize)
        needsDisplay = true
    }
    override func acceptsFirstMouse(for event: NSEvent?) -> Bool{
        return true
    }
    override func mouseDown(with event: NSEvent){
        CodeDogCurrentEventView = self
        window?.makeFirstResponder(self)
        parent.EventDispatcher.dispatchPointerClickEvent(event)
    }
    override func mouseUp(with event: NSEvent){
        CodeDogCurrentEventView = self
        parent.EventDispatcher.dispatchPointerClickEvent(event)
    }
    override func rightMouseDown(with event: NSEvent){
        CodeDogCurrentEventView = self
        window?.makeFirstResponder(self)
        parent.EventDispatcher.dispatchPointerClickEvent(event)
    }
    override func rightMouseUp(with event: NSEvent){
        CodeDogCurrentEventView = self
        parent.EventDispatcher.dispatchPointerClickEvent(event)
    }
    override func mouseMoved(with event: NSEvent){
        CodeDogCurrentEventView = self
        parent.EventDispatcher.dispatchPointerMotionEvent(event)
    }
    override func mouseDragged(with event: NSEvent){
        CodeDogCurrentEventView = self
        parent.EventDispatcher.dispatchPointerMotionEvent(event)
    }
    override func rightMouseDragged(with event: NSEvent){
        CodeDogCurrentEventView = self
        parent.EventDispatcher.dispatchPointerMotionEvent(event)
    }
    override func scrollWheel(with event: NSEvent){
        CodeDogCurrentEventView = self
        parent.EventDispatcher.dispatchScrollEvent(event)
        super.scrollWheel(with: event)
    }
    override var acceptsFirstResponder: Bool {return true}
    override func keyDown(with event: NSEvent){
        parent.EventDispatcher.dispatchKeyboardEvent(event)
    }
    override func keyUp(with event: NSEvent){
        parent.EventDispatcher.dispatchKeyboardReleaseEvent(event)
    }
};
`

/////////////////////////////////  STRUCT CONVERTERS
struct GUI_rect                 {me double: x1 me double: y1 me double: x2 me double: y2}
struct GUI_item:                wraps = NSView{}
struct GUI_Frame:               wraps = NSView{}
struct GUI_canvas:              wraps = CanvasView{}
struct GUI_container:           wraps = NSView{}
//struct INK_Image:               wraps = CGImage{}      // How will the ink look?
struct GUI_callback:            wraps = GCallback{}
struct GUI_Scalar:              wraps = Int{}
//struct GUI_Text:                wraps = GtkWidget{}
struct GUI_MotionEvent:         wraps = NSEvent{}
struct GUI_ButtonEvent:         wraps = NSEvent{}
struct GUI_PointerEvent:        wraps = NSEvent{}
struct GUI_KeyboardEvent:       wraps = NSEvent{}
struct GUI_UserEvent:           wraps = NSEvent{}
struct GUI_TimeEvent:           wraps = NSEvent{}
struct GUI_DataEvent:           wraps = NSEvent{}
struct GUI_WindowEvent:         wraps = NSEvent{}
struct GUI_ctxt:                wraps = CGContext{}
/////////////////////////////////  GLOBAL WIDGET FUNCTIONS
struct GLOBAL{
    me void: addToContainer(me GUI_container: container, me GUI_item: widget) <- <%!CodeDogAddToContainer(%1, %2, false)%>
    me void: addToContainerAndExpand(me GUI_container: container, me GUI_item: widget) <- <%!CodeDogAddToContainer(%1, %2, true)%>
}
/////////////////////////////////  HANDLE EVENTS
struct GUI_MotionEvent{
    me int: x <- <%!%0!.x%>
    me int: y <- <%!%0!.y%>
}
struct GUI_ButtonEvent{
    me int: x <- <%!%0!.x%>
    me int: y <- <%!%0!.y%>
}
struct GUI_PointerEvent{
    me int: x <- <%!%0!.x%>
    me int: y <- <%!%0!.y%>
}
struct GUI_KeyboardEvent{
}
/////////////////////////////////  EVENT DISPATCHER
struct GUI_eventDispatcher{
    their widget: topWidget

    me bool: dispatchPointerMotionEvent(their GUI_MotionEvent: event) <- <%{
        //let alert = NSAlert(); alert.messageText = "MouseMoved."; alert.runModal()
        //event.locationInWindow.x = event.locationInWindow.x / scaleFactor;
        //event.locationInWindow.y = event.locationInWindow.y / scaleFactor;
        topWidget.mouseMoved(event);
        return false;
    }%>
    me bool: dispatchScrollEvent(their GUI_MotionEvent: event) <- <%{
        return(topWidget.mouseWheel(event));
    }%>
    me bool: dispatchPointerClickEvent(their GUI_ButtonEvent: event) <- <%{
        var returnVal: Bool = false;
        switch(event.type){
            case .leftMouseDown:
                if event.clickCount >= 2 {
                    returnVal = topWidget.primaryDblClick(event);
                } else {
                    returnVal = topWidget.primaryDn(event);
                }
                break;
            case .leftMouseUp:
                returnVal = topWidget.primaryUp(event);
                if(!returnVal){
                    returnVal = topWidget.primaryClick(event);
                }
                break;
            case .rightMouseDown:
                if event.clickCount >= 2 {
                    returnVal = topWidget.secondaryDblClick(event);
                } else {
                    returnVal = topWidget.secondaryDn(event);
                }
                break;
            case .rightMouseUp:
                returnVal = topWidget.secondaryUp(event);
                if(!returnVal){
                    returnVal = topWidget.secondaryClick(event);
                }
                break;
            default:
                return false;
        }
        return returnVal;
    }%>
    me bool: dispatchKeyboardEvent(their GUI_KeyboardEvent: event) <- <%{
        var returnVal: Bool = topWidget.keyDown(event);
        if(topWidget.keyTyped(event)){
            returnVal = true;
        }
        return(returnVal);
    }%>
    me bool: dispatchKeyboardReleaseEvent(their GUI_KeyboardEvent: event) <- <%{
        return(topWidget.keyUp(event));
    }%>
    me void: registerControlForEventDispatcher(me GUI_item: Widget, their widget: masterWidget) <- <%{
        topWidget = masterWidget;
        if let button = Widget as? CodeDogButton {
            button.codeDogWidget = masterWidget;
        } else if let textField = Widget as? CodeDogTextField {
            textField.codeDogWidget = masterWidget;
        } else if let listBox = Widget as? CodeDogListBox {
            listBox.codeDogWidget = masterWidget;
        }
    }%>
    me void: registerWidgetForEventDispatcher(me CanvasView: appWidget, their widget: masterWidget) <- {
        topWidget<-masterWidget
    }
}

/////////////////////////////////  HANDLE GUI
struct GUI_canvas{
    me void: setParent(our DashboardWidget: wid) <- <%!setParent(%1)%>
}

/////////////////////////////////  HANDLE GUI
struct GUI{
    me GUI_Frame: frame

    me none: GUI() <- {}
    me uint32: GUI_Init() <- <%{
        CodeDogAppDelegate = AppDelegate()
        NSApplication.shared.delegate = CodeDogAppDelegate
        _ = NSApplicationMain(CommandLine.argc, CommandLine.unsafeArgv)
        return(0);
    }%>
    me uint32: GUI_Run() <- <%{
        let status: UInt32 = 0;
        return(status);
    }%>
    me void: GUI_Deinit() <- {}
}

struct GUI{
    their GUI_item: newCanvas() <- <%!%GCanvasView()%>
    their GUI_item: newLabel(me string: text) <- <%{
        let label = NSTextField(labelWithString: text)
        label.lineBreakMode = .byTruncatingTail
        label.alignment = .left
        return(label);
    }%>
    their GUI_item: newButton(me string: text) <- <%!%GCodeDogButton(title: %1)%>
    their GUI_item: newTextField(me string: text) <- <%!%GCodeDogTextField(text: %1)%>
    their GUI_item: newListBox() <- <%!%GCodeDogListBox(frame: .zero)%>
    me void: setWidgetSize(me GUI_item: widget, me uint32: width, me uint32: height) <- <%!%G%1.setFrameSize(NSSize(width: CGFloat(%2), height: CGFloat(%3)))%>
    me void: setControlText(me GUI_item: widget, me string: text) <- <%{
        if let textField = widget as? NSTextField {
            textField.stringValue = text;
        } else if let button = widget as? NSButton {
            button.title = text;
        }
    }%>
    me string: getControlText(me GUI_item: widget) <- <%{
        if let textField = widget as? NSTextField {
            return(textField.stringValue);
        }
        if let button = widget as? NSButton {
            return(button.title);
        }
        return("");
    }%>
    me void: addListItem(me GUI_item: listWidget, me string: text) <- <%!%G(%1 as? CodeDogListBox)?.addItem(%2)%>
    me void: clearList(me GUI_item: listWidget) <- <%!%G(%1 as? CodeDogListBox)?.clearItems()%>
    me void: setListSelectedIndex(me GUI_item: listWidget, me int: index) <- <%!%G(%1 as? CodeDogListBox)?.setSelectedIndex(%2)%>
    me int: getListSelectedIndex(me GUI_item: listWidget) <- <%{
        return((listWidget as? CodeDogListBox)?.selectedIndex() ?? -1);
    }%>
    me string: getListSelectedText(me GUI_item: listWidget) <- <%{
        return((listWidget as? CodeDogListBox)?.selectedText() ?? "");
    }%>
    their GUI_item: newScrollingWindow() <- <%{
        let scrollView = NSScrollView()
        scrollView.hasVerticalScroller = true
        scrollView.hasHorizontalScroller = false
        scrollView.autohidesScrollers = false
        scrollView.drawsBackground = true
        return(scrollView);
    }%>
    //me void: addMenuBar(me GUI_menuBar: menubar) <- <%!%>
    me void: setCallback() <- <%!%G%>
    me GUI_Frame: GUI_Frame(me string: label) <- <%!%GNSView()%>
}

struct GUI_ctxt{
    //me void: fetchAreaToBeDrawn(me GUI_rect: area) <- <%!%>
    //me void: reset()                                  <- <%!%>
    me void: setRGBA(me double: red, me double: green, me double: blue, me double: alpha) <- <%!CodeDogSetContextColor(%0, %1, %2, %3, %4)%>
    me void: setRGB (me double: red, me double: green, me double: blue) <- <%!CodeDogSetContextColor(%0, %1, %2, %3, 255.0)%>
    me void: setColor(me cdColor: color)                <- <%!CodeDogSetContextCdColor(%0, %1)%>
    me void: setLineWidth(me double: width)             <- <%!setLineWidth(CGFloat(%1))%>
    me void: setRoundLineCap()                          <- <%!setLineCap(.round)%>
    me void: setEdgedLineCap()                          <- <%!setLineCap(.butt)%>
    //me void: finishPDF()                                <- <%!closePDF()%>
    me void: setScale(me double: scaleX, me double: scaleY) <- <%!scaleBy(x: CGFloat(%1), y: CGFloat(%2))%>
    me void: setOffset(me double: offsetX, me double: offsetY) <- <%!translateBy(x: CGFloat(%1), y: CGFloat(%2))%>
    me void: moveTo(me double: x, me double: y)         <- <%!move(to:CGPoint(x:%1, y:%2))%>
    me void: lineTo(me double: x, me double: y)         <- <%!addLine(to:CGPoint(x:%1, y:%2))%>
    me void: moveRel(me double: dx, me double: dy)       <- <%!%0!.move(to: CGPoint(x: %0!.currentPointOfPath.x + CGFloat(%1), y: %0!.currentPointOfPath.y + CGFloat(%2)))%>
    me void: lineRel(me double: dx, me double: dy)       <- <%!%0!.addLine(to: CGPoint(x: %0!.currentPointOfPath.x + CGFloat(%1), y: %0!.currentPointOfPath.y + CGFloat(%2)))%>
    me void: curveTo(me double: x1, me double: y1, me double: x2, me double: y2, me double: x3, me double: y3) <- <%!addCurve(to: CGPoint(x: %5, y: %6), control1: CGPoint(x: %1, y: %2), control2: CGPoint(x: %3, y: %4))%>
    me void: curveRel(me double: dx1, me double: dy1, me double: dx2, me double: dy2, me double: dx3, me double: dy3) <- <%!%0!.addCurve(to: CGPoint(x: %0!.currentPointOfPath.x + CGFloat(%5), y: %0!.currentPointOfPath.y + CGFloat(%6)), control1: CGPoint(x: %0!.currentPointOfPath.x + CGFloat(%1), y: %0!.currentPointOfPath.y + CGFloat(%2)), control2: CGPoint(x: %0!.currentPointOfPath.x + CGFloat(%3), y: %0!.currentPointOfPath.y + CGFloat(%4)))%>
    me void: closePath()                                <- <%!closePath()%>
    me void: rectangle(me double: x, me double: y, me double: w, me double: h) <- <%!addRect(CGRect(x:%1, y:%2, width:%3, height:%4))%>
    me void: paintNow()                                 <- <%!%0!.fill(CodeDogCurrentPaintRect)%>
    me void: strokeNow()                                <- <%!strokePath()%>
    me void: fillNow()                                  <- <%!fillPath()%>
    me void: strokeKeep()                               <- <%!if let codeDogPath = %0!.path { %0!.strokePath(); %0!.addPath(codeDogPath) }%>
    me void: fillKeep()                                 <- <%!if let codeDogPath = %0!.path { %0!.fillPath(); %0!.addPath(codeDogPath) }%>
    me void: strokeAndFillPath()                        <- <%!drawPath(using: .fillStroke)%>
    //me void: setFillPattern()                         <- <%!%>
    me void: circle(me int: centerX, me int: centerY, me int: radius) <- <%!addEllipse(in:CGRect(x: %1-%3, y: %2-%3, width: 2*%3, height: 2*%3))%>
    me GUI_ctxt: newPDF_ctxt(me sting: filename, me double: inchesWide, me double: inchesHigh) <- {}
}

struct GUI_ctxt{
    me Paint: paint
    me Path: GPath
    me double: cur_x
    me double: cur_y
    me Canvas: GCanvas

    me none: GUI_ctxt () <- {
        Allocate(paint)
        Allocate(GPath)
    }

    me none: GUI_ctxt(me Canvas: canvas) <- {
        Allocate(paint)
        Allocate(GPath)
        GCanvas <- canvas
    }
}

struct APP{
    //me none: APP() <- <%{}%>
}
/////////////////////////////////  G L O B A L
struct GLOBAL: inherits=AppCompatActivity{
    // //TIME ROUTINES:
    //me long: ticksPerSec()    <- <%!%>
    //me int64: getCurrentTimeStamp() <- <%!%>
    me int64: guiMonotonicMillis() <- <%!%GInt64(ProcessInfo.processInfo.systemUptime * 1000)%>
    their NSWindow: window
    me int: widgetHeight() <- <%!%G(Int)(%1.bounds.size.height)%>
    me int: widgetWidth()  <- <%!%G(Int)(%1.bounds.size.width)%>
    me int: displayHeightPx
    me int: displayWidthPx

    // //DRAWING ROUTINES:
    me deltaSize: renderText(their GUI_ctxt: cr, me string: text, me fontSpec: font, me GUI_Scalar: x, me GUI_Scalar: y) <- <%{
        cr.saveGState()
        let nsFont = CodeDogFont(font)
        let attrs: [NSAttributedString.Key: Any] = [
            .font: nsFont,
            .foregroundColor: CodeDogCurrentTextColor
        ]
        NSAttributedString(string: text, attributes: attrs).draw(at: CGPoint(x: CGFloat(x), y: CGFloat(y) - nsFont.ascender))
        cr.restoreGState()
        //////////////////////////
        var size:deltaSize = getTextSize(cr, text, font);
        return(size);
    }%>
    me deltaSize: renderTextCentered(their GUI_ctxt: cr, me string: text, their fontSpec: font, me double: x, me double: y) <- <%{
        let size = getTextSize(text, font);
        renderText(cr, text, font, Int(x) - size.width/2, Int(y));
        return(size);
    }%>
    me deltaSize: renderTextRotate(their GUI_ctxt: cr, me string: text, their fontSpec: font, me double: x, me double: y, me double: degrees, me string: justify) <- <%{
        let radians = degrees * (Double.pi / 180.0);
        let size = getTextSize(text, font);
        let hypotenuseWidth = Double(size.width);
        var drawX = x;
        if justify == "right" {
            drawX = x - hypotenuseWidth;
        } else if justify == "center" {
            drawX = x - hypotenuseWidth / 2.0;
        }
        rotate(cr, x, y, Int(degrees));
        renderText(cr, text, font, Int(drawX), Int(y));
        cr.restoreGState();
        let tmpSize = deltaSize();
        tmpSize.height = Int(cos(abs(radians)) * hypotenuseWidth);
        tmpSize.width = Int(sin(abs(radians)) * hypotenuseWidth);
        let hypotenuseHeight = Double(size.height);
        let heightRadians = Double.pi / 2.0 - abs(radians);
        tmpSize.height = tmpSize.height + Int(sin(heightRadians) * hypotenuseHeight);
        tmpSize.width = tmpSize.width + Int(cos(heightRadians) * hypotenuseHeight);
        return(tmpSize);
    }%>
    me void: rotate(their GUI_ctxt: cr, me double: x, me double: y, me int: degrees) <- <%{
        let radians = CGFloat(degrees) * .pi / 180.0;
        cr.saveGState();
        cr.translateBy(x: CGFloat(x), y: CGFloat(y));
        cr.rotate(by: radians);
        cr.translateBy(x: CGFloat(-x), y: CGFloat(-y));
    }%>
    me void: restore(their GUI_ctxt: cr) <- <%!%1.restoreGState()%>
    me deltaSize: getTextSize(their GUI_ctxt: cr, me string: text, me fontSpec: font) <- <%{
        return(getTextSize(text, font));
    }%>
    me deltaSize: getTextSize(me string: text, their fontSpec: font) <- <%{
        let result = deltaSize();
        let attrs: [NSAttributedString.Key: Any] = [.font: CodeDogFont(font)]
        let measured = (text as NSString).size(withAttributes: attrs)
        result.width = Int(measured.width)
        result.height = Int(measured.height)
        return(result);
    }%>
    me deltaSize: getTextSizeX1024(me string: text, their fontSpec: font) <- <%{
        let result = getTextSize(text, font);
        result.width = result.width * 1024;
        result.height = result.height * 1024;
        return(result);
    }%>
    void: displayBackgroundImage(their GUI_ctxt: cr, me string: filename) <- <%{
        // TODO: implement image loading for the macOS Swift toolkit.
    }%>
    me void: displayImage(their GUI_ctxt: cr, me string: filename, me double: x, me double: y, me double: scale) <- <%{
        guard let image = CodeDogLoadImage(filename) else {
            return;
        }
        let drawRect = NSRect(
            x: CGFloat(x),
            y: CGFloat(y),
            width: image.size.width * CGFloat(scale),
            height: image.size.height * CGFloat(scale)
        );
        image.draw(in: drawRect, from: .zero, operation: .sourceOver, fraction: 1.0);
    }%>

    // //GUI INTERFACE:
    //me void: copyAssetToWritableFolder(me string: fromPath, me string: toPath)<- <%{}%>
    me void: getMetrics()                           <- <%{displayDensity = 1;}%>
    //me void: showWidget(me GUI_item: widget)      <- <%!%>
    //me void: hideWidget(their GUI_item: widget)   <- <%!%>
    me void: markDirtyArea(me GUI_item: widget, me int32: x, me int32: y, me int32: width, me int32: height) <- <%!%G%1.setNeedsDisplay(NSRect(x: CGFloat(%2), y: CGFloat(%3), width: CGFloat(%4), height: CGFloat(%5)))%>
    me GUI_item: newCanvas()                        <- <%!%GNSView()%>
    me void: setWidgetSize(me GUI_item: widget, me uint32: width, me uint32: height) <- <%!%G%1.setFrameSize(NSSize(width: CGFloat(%2), height: CGFloat(%3)))%>
}

/////////////////////////////////  INTER-THREAD COMMUNICATION
