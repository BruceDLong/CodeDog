// Set.Java.Lib.dog
requirements = [
    [tagOneOf, Lang, [Java]]
]

interface={
    provides = [Set_implementation]
    libFiles = []
    headers  = [java.util.HashSet, java.util.Set]
}

LibDescription ={
    useStatus   = dynamic
    description = 'Hash set provider for Java'
}

embedVeryHigh = `
class JavaSetCursor<T> {
    public T val;
    public boolean valid;

    public JavaSetCursor() {
        valid = false;
    }

    public JavaSetCursor(Set<T> set, T lookupValue) {
        if (set.contains(lookupValue)) {
            val = lookupValue;
            valid = true;
        } else {
            valid = false;
        }
    }

    public static <T> JavaSetCursor<T> end() {
        return new JavaSetCursor<T>();
    }

    public static <T> JavaSetCursor<T> endFor(Set<T> ignored) {
        return end();
    }

    public boolean isEqual(JavaSetCursor<T> other) {
        if (!valid && !other.valid) {
            return true;
        }
        if (valid != other.valid) {
            return false;
        }
        return val.equals(other.val);
    }
}
`

struct Java_HashSet<nodeType>: implements=Set wraps=HashSet native=lang specs={insert=constant find=constant contains=constant rangeIteration=dontUse}{
    const struct: iterator_Java_Set(nodeType: value): implements=SetItr wraps=JavaSetCursor native=lang <- {
        me nodeType: val()                      <- <%!%0.val%>
    }

    void: add(nodeType: value)                  <- <%!add(%1)%>
    void: clear()                               <- <%!clear()%>
    me bool: contains(nodeType: value)          <- <%!contains(%1)%>
    me iterator_Java_Set: end()                <- <%!JavaSetCursor.<%T0Type>endFor(%0)%>
    void: erase(nodeType: value)                <- <%!remove(%1)%>
    me iterator_Java_Set: find(nodeType: value) <- <%!new JavaSetCursor<%T0Type>(%0, %1)%>
    nodeType: first()                           <- <%!%0.iterator().next()%>
    me iterator_Java_Set: front()              <- <%!new JavaSetCursor<%T0Type>(%0, %0.iterator().next())%>
    void: insert(nodeType: value)               <- <%!add(%1)%>
    me bool: isEmpty()                          <- <%!isEmpty()%>
    me uint: size()                             <- <%!size()%>
}
