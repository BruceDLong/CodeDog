// CodeDog Thread Library

requirements = [
    [require, threads_implementation]
]

interface={
    provides=[Threads]
    libFiles=[]
    headers=[] //threads
}

LibDescription  ={
    useStatus   = dynamic
    description ='Library for multi-thread programming'
    features    =[Threads]
    platforms   =[Linux, OS-X_Devices, Windows, Web]
}

struct GLOBAL{
    // Input buffers use this wait so native runtimes can suspend an explicitly
    // registered outer lock. Without such a scope it is an ordinary wait.
    void: waitForInput(me SyncLock: condition, me MutexMngr: lock)
    void: yieldInputLock()
    me string: thisThreadID()
}
struct Threads{
    me bool: notDone <- true
    void: run()
    void: setName(me string: Name)
    bool: isActive()
    void: start()
    void: waitForExit()
    void: requestClose() <- {notDone <- false}

}
struct Mutex{
    void: lock()
    void: unlock()
    bool: tryLock()
}
struct MutexMngr{
    void: lock()
    void: unlock()
    bool: tryLock()
    none: MutexMngr(me Mutex: __mutex)
}
struct SyncLock{
    void: wait(me MutexMngr: lock)
    void: notifyOne()
    void: notifyAll()
}
struct Semaphore{
    void: post()
    void: wait()
}

// Scoped input-lock bindings currently implemented by the C++/Web runtime.
struct InputLock{}
struct InputPause{}
