// List.Java.Lib.dog
requirements = [
    [tagOneOf, Lang, [Java]]
]

interface={
    provides = [List_implementation]
    libFiles = []
    headers  = [java.util.ArrayList, java.util.LinkedList]
}

LibDescription ={
    useStatus   = dynamic
    description = 'List in routines for Java'
}

struct Java_ArrayList<nodeType>: implements=List wraps=ArrayList native=lang specs={insert=linear append=constant prepend=linear at=constant rangeIteration=constant}{
    void: append(nodeType: value)               <- <%!add(%1)%>
    nodeType: at(me int: position)              <- <%!%0.get(%1)%>
    void: clear()                               <- <%!clear()%>
    void: clipToSize(me int: size)              <- <%!while(%0.size() > %1) { %0.remove(%0.size() - 1); }%>
    me nodeType: deleteNth(me int: position)   <- <%!%0.remove(%1)%>
    me nodeType: erase(me nodeType: position) <- <%!remove(%1)%>
    nodeType: first()                           <- <%!get(0)%>
    nodeType: __getAt(me int: position)         <- <%!%0.get(%1)%>
    me nodeType: insertIdx(me int: position, nodeType: value) <- <%!%0.add(%1, %2)%>
    me bool: isEmpty()                          <- <%!isEmpty()%>
    nodeType: last()                            <- <%!%0.get(%0.size()-1)%>
    nodeType: popFirst()                        <- <%!remove(0)%>
    nodeType: popLast()                         <- <%!%0.remove(%0.size() - 1)%>
    me void: prepend(nodeType: value)           <- <%!add(0, %1)%>
    me uint: size()                             <- <%!size()%>
}

struct Java_LinkedList<nodeType>: implements=List wraps=LinkedList native=lang specs={insert=linear append=constant prepend=constant at=linear rangeIteration=constant}{
    void: append(nodeType: value)               <- <%!add(%1)%>
    nodeType: at(me int: position)              <- <%!%0.get(%1)%>
    void: clear()                               <- <%!clear()%>
    void: clipToSize(me int: size)              <- <%!while(%0.size() > %1) { %0.removeLast(); }%>
    me nodeType: deleteNth(me int: position)   <- <%!%0.remove(%1)%>
    me nodeType: erase(me nodeType: position) <- <%!remove(%1)%>
    nodeType: first()                           <- <%!getFirst()%>
    nodeType: __getAt(me int: position)         <- <%!%0.get(%1)%>
    me nodeType: insertIdx(me int: position, nodeType: value) <- <%!%0.add(%1, %2)%>
    me bool: isEmpty()                          <- <%!isEmpty()%>
    nodeType: last()                            <- <%!getLast()%>
    nodeType: popFirst()                        <- <%!removeFirst()%>
    nodeType: popLast()                         <- <%!removeLast()%>
    me void: prepend(nodeType: value)           <- <%!addFirst(%1)%>
    me uint: size()                             <- <%!size()%>
}
