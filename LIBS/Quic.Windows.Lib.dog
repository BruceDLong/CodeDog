//############ Quic Windows stub implementation
requirements = [
    [tagOneOf, Platform, [Windows]]
]

interface={
    provides=[Quic_implementation]
    libFiles=[]
    headers=[]
}

LibDescription ={
    useStatus   = dynamic
    description ='Windows stub for the CodeDog Quic interface'
    platforms   =[Windows]
    bindings    =[C, CPP]
}

featuresNeeded = [Logger]

struct GLOBAL{
    void: initQuicSystem() <- {}
    void: deinitQuicSystem() <- {}
}

struct QuicConnectionID{}

struct QuicEngine{
    void: init(me string: filenameTag, me bool: ServerMode, me string: ipAddr, me int:portNum) <- {
        isServer <- ServerMode
        print("QUIC is not implemented for Windows yet.\n")
    }
    void: start() <- {}
    me bool: setupClientConnection(their QuicConnection: qConn, me string: ipAddr, me string:portNum) <- {
        print("QUIC client connections are not implemented for Windows yet.\n")
        return(false)
    }
    void: destroy() <- {}
}

struct QuicConnection{
    their QuicConnectionID: getConnectionID() <- {
        their QuicConnectionID:: retval
        return(retval)
    }
    void: createNewStream() <- {}
    void: abort() <- {}
}

struct QuicStream{
    me uint64: getStreamID() <- {return(0)}
    void: setPriority(me 1..256: priority) <- {}
    void: nextOpIsRead() <- {}
    void: nextOpIsWrite() <- {}
    void: doneReading() <- {}
    void: doneWriting() <- {}
    void: flushStream() <- {}
    void: stopReading() <- {}
    void: stopWriting() <- {}
    void: close() <- {}
    me int: read(me string:buf) <- {return(0)}
    me int: write(me string:buf) <- {return(buf.size())}
    their QuicConnection: getConnection() <- {return(myConnection)}
}
