// Map.Kotlin.Lib.dog
requirements = [
    [tagOneOf, Lang, [Kotlin]]
]

interface={
    provides = [Map_implementation]
    libFiles = []
    headers  = [java.util.HashMap]
}

LibDescription ={
    useStatus   = dynamic
    description = 'Map provider for Kotlin'
}

struct Kotlin_HashMap<keyType, valueType>: implements=Map wraps=HashMap native=lang specs={insert=constant find=constant at=constant}{
    valueType: at(keyType: key)                   <- <%!%0[%1]%>
    valueType: __index(keyType: key)              <- <%!%0[%1]%>
    void: clear()                                 <- <%!clear()%>
    me bool: containsKey(keyType: key)            <- <%!containsKey(%1)%>
    void: erase(keyType: key)                     <- <%!remove(%1)%>
    valueType: find(keyType: key)                 <- <%!%0[%1]%>
    itr valueType: insert(keyType: key, valueType: value) <- <%!put(%1, %2)%>
    me bool:  isEmpty()                           <- <%!isEmpty()%>
    me uint:  size()                              <- <%!%0.size%>
}
