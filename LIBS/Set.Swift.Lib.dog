// Set.Swift.Lib.dog
requirements = [
    [tagOneOf, Lang, [Swift]]
]

interface={
    provides = [Set_implementation]
    libFiles = []
    headers  = []
}

LibDescription ={
    useStatus   = dynamic
    description = 'Hash set provider for Swift'
}

embedVeryHigh = `
public class SwiftSetCursor<T: Hashable>: Equatable {
    public var val: T?
    public var valid: Bool

    public init() {
        valid = false
    }

    public init(_ set: Set<T>, _ lookupValue: T) {
        if set.contains(lookupValue) {
            val = lookupValue
            valid = true
        } else {
            valid = false
        }
    }

    public static func end() -> SwiftSetCursor<T> {
        return SwiftSetCursor<T>()
    }

    public func isEqual(_ other: SwiftSetCursor<T>) -> Bool {
        if !valid && !other.valid {
            return true
        }
        if valid != other.valid {
            return false
        }
        return val == other.val
    }

    public static func == (lhs: SwiftSetCursor<T>, rhs: SwiftSetCursor<T>) -> Bool {
        return lhs.isEqual(rhs)
    }
}
`

struct Swift_HashSet<nodeType>: implements=Set wraps=Set native=lang specs={insert=constant find=constant contains=constant rangeIteration=dontUse}{
    const struct: iterator_Swift_Set(nodeType: value): implements=SetItr wraps=SwiftSetCursor native=lang <- {
        me nodeType: val()                      <- <%!%0.val!%>
        me bool: __isEqual(me iterator_Swift_Set: RHS) <- <%!%0.isEqual(%1)%>
    }

    void: add(nodeType: value)                  <- <%!insert(%1)%>
    void: clear()                               <- <%!removeAll()%>
    me bool: contains(nodeType: value)          <- <%!contains(%1)%>
    me iterator_Swift_Set: end()               <- <%!%GSwiftSetCursor<%T0Type>.end()%>
    void: erase(nodeType: value)                <- <%!remove(%1)%>
    me iterator_Swift_Set: find(nodeType: value) <- <%!SwiftSetCursor<%T0Type>(%0, %1)%>
    nodeType: first()                           <- <%!%0.first!%>
    me iterator_Swift_Set: front()             <- <%!SwiftSetCursor<%T0Type>(%0, %0.first!)%>
    void: insert(nodeType: value)               <- <%!insert(%1)%>
    me bool: isEmpty()                          <- <%!isEmpty%>
    me uint: size()                             <- <%!count%>
}
