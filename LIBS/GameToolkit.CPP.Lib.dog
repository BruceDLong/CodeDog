}
struct GameEvent{
    me int32: type
    me UserEvent: user
    me WindowEvent: window
    me KeyboardEvent: key
    me MouseButtonEvent: button
    me MouseMotionEvent: motion
    me MouseWheelEvent: wheel
}
struct UserEvent{
    me int32: code
}
struct WindowEvent{
    me int32: event
    me int32: data1
    me int32: data2
}
struct KeyboardEvent{
    me KeyInfo: keysym
}
struct KeyInfo{
    me Keycode: sym
}
struct MouseButtonEvent{
    me int32: type
    me int32: x
    me int32: y
}

/////////////////////////////////  SOUND
struct GameSound{
    void: loadFromFile(me string: fileName) <- <%{
        if(data != nullptr){
            Mix_FreeChunk(data);
            data = nullptr;
        }
        name = fileName;
        data=Mix_LoadWAV(name.data());
        if(!data) {
            printf("Mix_LoadWAV: %s\n", Mix_GetError());
        }
    }%>
    void: play() <-  <%{
        if(data != nullptr){
            Mix_PlayChannel(-1, data, 0);
        }
    }%>
}
