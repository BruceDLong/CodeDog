// List.Kotlin.Lib.dog
requirements = [
    [tagOneOf, Lang, [Kotlin]]
]

interface={
    provides = [List_implementation]
    libFiles = []
    headers  = [java.util.ArrayList, java.util.LinkedList]
}

LibDescription ={
    useStatus   = dynamic
    description = 'List routines for Kotlin'
}

struct Kotlin_ArrayList<nodeType>: implements=List wraps=ArrayList native=lang specs={insert=linear append=constant prepend=linear at=constant rangeIteration=constant}{
    void: append(nodeType: value)               <- <%!add(%1)%>
    nodeType: at(me int: position)              <- <%!%0[%1]%>
    void: clear()                               <- <%!clear()%>
    void: clipToSize(me int: size)              <- <%!trimToSize()%>
    me nodeType: deleteNth(me int: position)   <- <%!%0.removeAt(%1)%>
    me nodeType: erase(me nodeType: position) <- <%!remove(%1)%>
    nodeType: first()                           <- <%!%0[0]%>
    nodeType: __getAt(me int: position)         <- <%!%0[%1]%>
    me nodeType: insertIdx(me int: position, nodeType: value) <- <%!%0.add(%1, %2)%>
    me bool: isEmpty()                          <- <%!isEmpty()%>
    nodeType: last()                            <- <%!%0[%0.size - 1]%>
    nodeType: popFirst()                        <- <%!removeAt(0)%>
    nodeType: popLast()                         <- <%!%0.removeAt(%0.size - 1)%>
    me void: prepend(nodeType: value)           <- <%!add(0, %1)%>
    me uint: size()                             <- <%!%0.size%>
}

struct Kotlin_LinkedList<nodeType>: implements=List wraps=LinkedList native=lang specs={insert=linear append=constant prepend=constant at=linear rangeIteration=constant}{
    void: append(nodeType: value)               <- <%!add(%1)%>
    nodeType: at(me int: position)              <- <%!%0[%1]%>
    void: clear()                               <- <%!clear()%>
    void: clipToSize(me int: size)              <- <%!while(%0.size > %1) { %0.removeLast() }%>
    me nodeType: deleteNth(me int: position)   <- <%!%0.removeAt(%1)%>
    me nodeType: erase(me nodeType: position) <- <%!remove(%1)%>
    nodeType: first()                           <- <%!%0[0]%>
    nodeType: __getAt(me int: position)         <- <%!%0[%1]%>
    me nodeType: insertIdx(me int: position, nodeType: value) <- <%!%0.add(%1, %2)%>
    me bool: isEmpty()                          <- <%!isEmpty()%>
    nodeType: last()                            <- <%!%0[%0.size - 1]%>
    nodeType: popFirst()                        <- <%!removeFirst()%>
    nodeType: popLast()                         <- <%!removeLast()%>
    me void: prepend(nodeType: value)           <- <%!addFirst(%1)%>
    me uint: size()                             <- <%!%0.size%>
}
