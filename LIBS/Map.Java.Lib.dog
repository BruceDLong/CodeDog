// Map.Java.Lib.dog
requirements = [
    [tagOneOf, Lang, [Java]]
]

interface={
    provides = [Map_implementation]
    libFiles = []
    headers  = [java.util.HashMap, java.util.TreeMap, java.util.Map]
}

LibDescription ={
    useStatus   = dynamic
    description = 'Map in routines for Java'
}

embedVeryHigh = `
class JavaMapCursor<K, V> {
    public K key;
    public V val;
    public boolean valid;

    public JavaMapCursor() {
        valid = false;
    }

    public JavaMapCursor(Map<K, V> map, K lookupKey) {
        if (lookupKey != null && map.containsKey(lookupKey)) {
            key = lookupKey;
            val = map.get(lookupKey);
            valid = true;
        } else {
            valid = false;
        }
    }

    public static <K, V> JavaMapCursor<K, V> end() {
        return new JavaMapCursor<K, V>();
    }

    public static <K, V> JavaMapCursor<K, V> endFor(Map<K, V> ignored) {
        return end();
    }

    public boolean isEqual(JavaMapCursor<K, V> other) {
        if (!valid && !other.valid) {
            return true;
        }
        if (valid != other.valid) {
            return false;
        }
        return key.equals(other.key);
    }
}
`

struct Java_HashMap<keyType, valueType>: implements=Map wraps=HashMap native=lang specs={insert=constant find=constant at=constant rangeIteration=dontUse}{
    const struct: iterator_Java_Map(keyType: key, valueType: value): implements=MapItr wraps=JavaMapCursor native=lang <- {
        me keyType: key()                        <- <%!%0.key%>
        me valueType: val()                      <- <%!%0.val%>
    }

    valueType: at(keyType: key)                  <- <%!%0.get(%1)%>
    valueType: __index(keyType: key)             <- <%!%0.get(%1)%>
    void: clear()                                <- <%!clear()%>
    me bool: containsKey(keyType: key)           <- <%!containsKey(%1)%>
    itr iterator_Java_Map: end()                 <- <%!JavaMapCursor.<%T0Type, %T1Type>endFor(%0)%>
    void: erase(keyType: key)                    <- <%!remove(%1)%>
    itr iterator_Java_Map: find(keyType: key)    <- <%!new JavaMapCursor<%T0Type, %T1Type>(%0, %1)%>
    valueType: first()                           <- <%!%0.values().iterator().next()%>
    itr valueType: insert(keyType: key, valueType: value) <- <%!put(%1, %2)%>
    me bool:  isEmpty()                          <- <%!isEmpty()%>
    valueType: last()                            <- <%!%0.values().iterator().next()%>
    me uint:  size()                             <- <%!size()%>
}

