};
vector<CodeDogPeriodicCallback> CodeDogPeriodicCallbacks;
VOID CALLBACK CodeDogPeriodicTimerProc(HWND window, UINT message, UINT_PTR timerID, DWORD timeMillis);
void CodeDogCallPeriodically(int intervalMillis, int (*callback)(void*), void* data);
LRESULT CALLBACK WndProc(HWND, UINT, WPARAM, LPARAM);
LRESULT CALLBACK CanvasWndProc(HWND, UINT, WPARAM, LPARAM);
LRESULT CALLBACK ScrollWndProc(HWND, UINT, WPARAM, LPARAM);
HWND CodeDogCreateCanvasWindow(HWND parentWindow);
