//############  Add GUI-Toolkit features using Windows API (previously
//                  known as Win32)
requirements = [
    [tagOneOf, Platform, [Windows]]
]

interface={
    provides=[GUI_ToolKit_implementation]
    libFiles=[Gdi32, User32, Msimg32, Gdiplus]
    headers=[windows.h, windowsx.h, stdlib.h, string.h, tchar.h, direct.h, winuser.h, wingdi.h, gdiplus.h, math.h]
}

LibDescription ={
    useStatus   = dynamic
    description ='Windows API is a GUI Toolkit'
    features    =[GUI_ToolKit]
    platforms   =[Windows]
    bindings    =[C, CPP]
    CPUs        =[i386, amd64, arm7]
}

embedAboveIncludes = `
#include <algorithm>
namespace Gdiplus {
    using std::max;
    using std::min;
}
`

// Injecting some Windows specific code at the top
embedHigh = `
POINT _tagPOINT;
