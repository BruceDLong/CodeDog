struct GUI_ctxt {
    me void: reset() <- <%!BeginPath(%0)%>
    me void: setRGBA(me double: red, me double: green, me double: blue, me double: alpha) <- <%!%GobjectColor = RGB((int)%1, (int)%2, (int)%3)%>
    me void: setRGB (me double: red, me double: green, me double: blue) <- <%!%GobjectColor = RGB((int)%1, (int)%2, (int)%3)%>
    me void: setColor(me cdColor: color) <- <%!%GobjectColor = RGB((int)%1.red, (int)%1.green, (int)%1.blue)%>
    me void: setLineWidth(me double: width) <- <%!%GpenWidth = (int)%1;%>
    me void: setRoundLineCap() <- <%!%GpenEndCap = PS_ENDCAP_ROUND;%>
    me void: setEdgedLineCap() <- <%!%GpenEndCap = PS_ENDCAP_FLAT;%>
    me void: finishPDF() <- <%!%G%>
    me void: setScale(me double: scaleX, me double: scaleY) <- <%!CodeDogScaleDC(%0, %1, %2);%>
    me void: setOffset(me double: offsetX, me double: offsetY) <- <%!CodeDogOffsetDC(%0, %1, %2);%>
    me void: moveTo(me double: x, me double: y) <- <%!MoveToEx(%0, (int)(%1), (int)(%2), NULL)%>
    me void: lineTo(me double: x, me double: y) <- <%!LineTo(%0, (int)(%1), (int)(%2))%>
    me void: moveRel(me double: dx, me double: dy) <- <%!
        GetCurrentPositionEx(%0, &_tagPOINT);
        MoveToEx(%0, _tagPOINT.x + (int)%1, _tagPOINT.y + (int)%2, NULL)
    %>
    me void: lineRel(me double: dx, me double: dy) <- <%!
        GetCurrentPositionEx(%0, &_tagPOINT);
        LineTo(%0, _tagPOINT.x + (int)%1, _tagPOINT.y + (int)%2)
    %>
    me void: curveTo(me double: x1, me double: y1, me double: x2, me double: y2, me double: x3, me double: y3) <- <%!
        { POINT bezierPts[3] = {{(LONG)(%1), (LONG)(%2)}, {(LONG)(%3), (LONG)(%4)}, {(LONG)(%5), (LONG)(%6)}}; PolyBezierTo(%0, bezierPts, 3); }
    %>
    me void: curveRel(me double: dx1, me double: dy1, me double: dx2, me double: dy2, me double: dx3, me double: dy3) <- <%!
        { GetCurrentPositionEx(%0, &_tagPOINT); POINT bezierPts[3] = {{_tagPOINT.x + (LONG)(%1), _tagPOINT.y + (LONG)(%2)}, {_tagPOINT.x + (LONG)(%3), _tagPOINT.y + (LONG)(%4)}, {_tagPOINT.x + (LONG)(%5), _tagPOINT.y + (LONG)(%6)}}; PolyBezierTo(%0, bezierPts, 3); }
    %>
    me void: closePath() <- <%!CloseFigure(%0)%>
    me void: rectangle() <- <%!Rectangle(%0, (int)(%1), (int)(%2), (int)(%1+%3), (int)(%2+%4))%>
    me void: paintNow() <- <%!
        RECT clientSize;
        HBRUSH backgroundBrush;
        HWND paintWindow = WindowFromDC(%0);
        if(paintWindow == NULL){paintWindow = hWnd;}
        GetClientRect(paintWindow, &clientSize);
        backgroundBrush = CreateSolidBrush(objectColor);
        FillRect(%0, &clientSize, backgroundBrush);
        DeleteObject(backgroundBrush);%>
    me void: strokeNow() <- <%!CodeDogPaintPath(%0, true, false, false);%>
    me void: fillNow() <- <%!CodeDogPaintPath(%0, false, true, false);%>
    me void: strokeKeep() <- <%!CodeDogPaintPath(%0, true, false, true);%>
    me void: fillKeep() <- <%!CodeDogPaintPath(%0, false, true, true);%>
    me void: strokeAndFillPath() <- <%!CodeDogPaintPath(%0, true, true, false);%>
    // GRADIENT IS NOT YET FUNCTIONAL
    me void: setFillPattern() <- <%!
        vertex[0].x = 900;
        vertex[0].y = 100;
        vertex[0].Red = 0x0000;
        vertex[0].Green = 0x8000;
        vertex[0].Blue = 0x8000;
        vertex[0].Alpha = 0x0000;
        vertex[1].x = 1300;
        vertex[1].y = 500;
        vertex[1].Red = 0x0000;
        vertex[1].Green = 0xd000;
        vertex[1].Blue = 0xd000;
        vertex[1].Alpha = 0x0000;

        gRect.UpperLeft = 0;
        gRect.LowerRight = 1;

        GradientFill(%0, vertex, 2, &gRect, 1, GRADIENT_FILL_RECT_V);
    %>
    me void: circle(me int: centerX, me int: centerY, me int: radius) <- <%!Ellipse(%0, %1-%3, %2-%3, %1+%3, %2+%3)%>
}
