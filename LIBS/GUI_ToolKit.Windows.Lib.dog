/////////////////////////////////  G L O B A L
struct GLOBAL{
    // TIME ROUTINES:
    me int64: getCurrentTimeStamp() <- <%!_time64(NULL)%>
    me void: getMetrics() <- <%{displayDensity = 1;}%>

    our string: getClipboardAsText() <- <%{
        if(!OpenClipboard(nullptr)){return(nullptr);}
        HANDLE hData = GetClipboardData(CF_TEXT);
        if(hData == nullptr){CloseClipboard(); return(nullptr);}
        char* clipboardText = static_cast<char*>(GlobalLock(hData));
        if(clipboardText == nullptr){CloseClipboard(); return(nullptr);}
        shared_ptr<string> retVal = make_shared<string>(clipboardText);
        GlobalUnlock(hData);
        CloseClipboard();
        return(retVal);
    }%>

    // DRAWING ROUTINES:
    me deltaSize: renderText(their GUI_ctxt: cr, me string: text, me fontSpec: font, me double: x, me double: y) <- <%{
        deltaSize size;
        SIZE winSize = {0, 0};
        vector<POINT> savedPathPoints;
        vector<BYTE> savedPathTypes;
        CodeDogSuspendPath(cr, savedPathPoints, savedPathTypes);

        std::wstring stemp = CodeDogFontName(font.name);
        LPCWSTR fontNamePtr = stemp.c_str();
        std::wstring stemp2 = s2ws(text);
        LPCWSTR outputTextPtr = stemp2.c_str();

        HFONT hFont = CreateFontW(CodeDogFontHeightForDC(cr, font.size), 0, 0, 0, FW_DONTCARE, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_TT_ONLY_PRECIS,
            CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, VARIABLE_PITCH, fontNamePtr);
        HGDIOBJ oldFont = SelectObject(cr, hFont);
        SetBkMode(cr, TRANSPARENT);
        SetTextColor(cr, objectColor);
        GetTextExtentPoint32W(cr, outputTextPtr, (int)stemp2.length(), &winSize);
        TEXTMETRICW textMetrics = {};
        GetTextMetricsW(cr, &textMetrics);
        TextOutW(cr, (int)x, (int)(y - textMetrics.tmAscent), outputTextPtr, (int)stemp2.length());
        SelectObject(cr, oldFont);
        DeleteObject(hFont);
        CodeDogResumePath(cr, savedPathPoints, savedPathTypes);
        size.width = winSize.cx;
        size.height = winSize.cy;
        return(size);
    } %>

    me deltaSize: renderTextCentered(their GUI_ctxt: cr, me string: text, their fontSpec: font, me double: x, me double: y) <- <%{
        deltaSize size = getTextSize(text, font);
        renderText(cr, text, *font, x - size.width / 2, y);
        return(size);
    }%>

    me deltaSize: renderTextRotate(their GUI_ctxt: cr, me string: text, their fontSpec: font, me double: x, me double: y, me double: degrees, me string: justify) <- <%{
        double radians = degrees * (3.14159265358979323846 / 180.0);
        deltaSize size = getTextSize(text, font);
        double hypotenuse = size.width;
        deltaSize tmpSize;
        double drawX = x;
        if(justify == "right"){drawX = x - hypotenuse;}
        else if(justify == "center"){drawX = x - hypotenuse / 2;}
        CodeDogRotateDC(cr, x, y, degrees);
        renderText(cr, text, *font, drawX, y);
        CodeDogRestoreDC(cr);
        tmpSize.height = (int)(cos(fabs(radians)) * hypotenuse);
        tmpSize.width = (int)(sin(fabs(radians)) * hypotenuse);
        hypotenuse = size.height;
        radians = 3.14159265358979323846 / 2 - fabs(radians);
        tmpSize.height = tmpSize.height + (int)(sin(radians) * hypotenuse);
        tmpSize.width = tmpSize.width + (int)(cos(radians) * hypotenuse);
        return(tmpSize);
    }%>

    me void: rotate(their GUI_ctxt: cr, me double: x, me double: y, me int: degrees) <- <%{
        CodeDogRotateDC(cr, x, y, degrees);
    }%>

    me void: restore(their GUI_ctxt: cr) <- <%!CodeDogRestoreDC(%1);%>


    me deltaSize: getTextSize(me string: text, their fontSpec: font) <- <%{
        deltaSize size;
        SIZE winSize = {0, 0};
        HWND measureWindow = hWnd ? hWnd : GetDesktopWindow();
        HDC dc = GetDC(measureWindow);
        std::wstring stemp = CodeDogFontName(font->name);
        HFONT hFont = CreateFontW(CodeDogFontHeightForDC(dc, font->size), 0, 0, 0, FW_DONTCARE, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_TT_ONLY_PRECIS,
            CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, VARIABLE_PITCH, stemp.c_str());
        HGDIOBJ oldFont = SelectObject(dc, hFont);
        std::wstring textW = s2ws(text);
        GetTextExtentPoint32W(dc, textW.c_str(), (int)textW.length(), &winSize);
        SelectObject(dc, oldFont);
        DeleteObject(hFont);
        ReleaseDC(measureWindow, dc);
        size.width=winSize.cx;
        size.height=winSize.cy;
        return(size);
    } %>

    me deltaSize: getTextSizeX1024(me string: text, their fontSpec: font) <- <%{
        deltaSize size = getTextSize(text, font);
        size.width = size.width * 1024;
        size.height = size.height * 1024;
        return(size);
    } %>
    void: displayBackgroundImage(their GUI_ctxt: cr, me string: filename) <- <%{
        CodeDogDisplayBackgroundImage(cr, filename);
    }%>

    me void: displayImage(their GUI_ctxt: cr, me string: filename, me double: x, me double: y, me double: scale) <- <%{
        CodeDogDisplayImage(cr, filename, x, y, scale);
    }%>

    me void: showWidget(their GUI_item: widget) <- <%!%GShowWindow(%1, SW_SHOW)%>
    me void: hideWidget(their GUI_item: widget) <- <%!%GShowWindow(%1, SW_HIDE)%>
    me void: markDirtyArea(their GUI_item: widget, me int32: x, me int32: y, me int32: width, me int32: height) <- <%!%G{RECT dirtyRect = {(LONG)%2, (LONG)%3, (LONG)(%2 + %4), (LONG)(%3 + %5)}; InvalidateRect(%1, &dirtyRect, FALSE);}%>
    me void: setWidgetSize(their GUI_item: widget, me uint32: width, me uint32: height) <- <%!%GCodeDogSetWidgetSize(%1, %2, %3)%>
    me int: widgetHeight(their GUI_item: widget) <- <%{RECT rect; GetClientRect(widget, &rect); return(rect.bottom - rect.top);}%>
    me int: widgetWidth(their GUI_item: widget) <- <%{RECT rect; GetClientRect(widget, &rect); return(rect.right - rect.left);}%>
    me void: addToContainer(their GUI_container: container, their GUI_item: widget) <- <%!%GCodeDogAttachChild(%1, %2, false)%>
    me void: addToContainerAndExpand(their GUI_container: container, their GUI_item: widget) <- <%!%GCodeDogAttachChild(%1, %2, true)%>
    me GUI_Scalar: convertToGUIScalar() <- <%!%G%1%>
