static void CodeDogPaintPath(HDC dc, bool strokePath, bool fillPath, bool preservePath);
static void CodeDogSuspendPath(HDC dc, vector<POINT>& pathPoints, vector<BYTE>& pathTypes);
static void CodeDogResumePath(HDC dc, const vector<POINT>& pathPoints, const vector<BYTE>& pathTypes);
