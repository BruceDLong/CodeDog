GRADIENT_RECT gRect;
int penWidth = 1;
int penEndCap = PS_ENDCAP_FLAT;
ULONG_PTR CodeDogGdiplusToken = 0;
const char CodeDogMainWindowClass[] = "CodeDogDesktopApp";
const char CodeDogCanvasWindowClass[] = "CodeDogCanvas";
