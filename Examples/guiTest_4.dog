// guiTest_4.dog
//
// Focused GUI event test after guiTest_3:
// - keyboard focus moving between child canvases
// - primary down/up/click/double-click routing
// - mouse capture while dragging across canvas boundaries

//LinuxBuild: Platform='Linux' CPU='amd64' Lang='CPP' LangVersion='GNU' optimize='speed';
WindowsBuild: Platform='Windows' CPU='amd64' Lang='CPP' LangVersion='MSVC' optimize='speed';
//SwingBuild: Platform='Java' CPU='JavaVM' Lang='Java' optimize='speed';
//AndroidBuild: Platform='Android' CPU='JavaVM' Lang='Java' optimize='power';
//iPhoneBuild: Platform='IOS' CPU='amd64' Lang='Swift' optimize='speed';
//MacBuild: Platform='MacOS' Lang='Swift' optimize='speed';

Title = "guiTest_4"
FileName = "guiTest_4"
Version = "1.0"
CopyrightMesg = "Public Domain"
Authors = "Bruce Long"
Description = "GUI test for focus, mouse capture, drag, and double-click across child canvases"
ProgramOrLibrary = "program"

featuresNeeded = [GUI_ToolKit, Dashboard, List]

LicenseText = `Public Domain`

runCode=``

mainStyle = {}

do makeStyler(mainStyle)
do makeGUI(GUI_Spec)

struct topFocusWidget: inherits=DashboardWidget{
    void: requestRedrawAll() <- {
        markDirtyArea(top_canvas, 0, 0, widgetWidth(top_canvas), widgetHeight(top_canvas))
        markDirtyArea(bottom_canvas, 0, 0, widgetWidth(bottom_canvas), widgetHeight(bottom_canvas))
    }

    void: draw(their GUI_ctxt: cr) <- {
        me int: canvasW <- widgetWidth(top_canvas)
        me int: canvasH <- widgetHeight(top_canvas)

        cr.setRGB(247, 251, 255)
        cr.paintNow()
        if(activePane == 1){
            cr.setRGB(0, 120, 80)
            cr.setLineWidth(5)
        } else {
            cr.setRGB(35, 85, 135)
            cr.setLineWidth(2)
        }
        cr.rectangle(10, 10, canvasW - 20, canvasH - 20)
        cr.strokeNow()

        if(topDownCount > 0){
            cr.setRGB(205, 55, 55)
            cr.setLineWidth(3)
            cr.moveTo(topDragStartX, topDragStartY)
            cr.lineTo(topDragX, topDragY)
            cr.strokeNow()
            cr.circle(topDragX, topDragY, 6)
            cr.fillNow()
        }

        cr.setRGB(0, 0, 0)
        cr.setLineWidth(1)
        our fontSpec:: titleFont{"Arial", "21"}
        our fontSpec:: bodyFont{"Arial", "15"}
        renderText(cr, "guiTest_4 top canvas", titleFont, 28, 42)
        if(activePane == 1){
            renderText(cr, "Focus: yes", bodyFont, 28, 72)
        } else {
            renderText(cr, "Focus: no", bodyFont, 28, 72)
        }
        renderText(cr, "Down/up/click/double: " + toString(topDownCount) + " / " + toString(topUpCount) + " / " + toString(topClickCount) + " / " + toString(topDoubleClickCount), bodyFont, 28, 102)
        renderText(cr, "Drag moves: " + toString(topDragMoveCount) + "   last: " + toString(topDragX) + ", " + toString(topDragY), bodyFont, 28, 132)
        renderText(cr, "Key typed/down/up: " + toString(topKeyTypedCount) + " / " + toString(topKeyDownCount) + " / " + toString(topKeyUpCount) + "   last: " + toString(topLastKey), bodyFont, 28, 162)
        renderText(cr, "Click here, type, double-click, then drag through the divider.", bodyFont, 28, 198)
    }

    me bool: primaryDn(their GUI_ButtonEvent: event) <- {
        activePane <- 1
        topDragging <- true
        topDownCount <- topDownCount + 1
        topDragStartX <- event.x
        topDragStartY <- event.y
        topDragX <- event.x
        topDragY <- event.y
        print("TOP DOWN x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: primaryUp(their GUI_ButtonEvent: event) <- {
        activePane <- 1
        topDragging <- false
        topUpCount <- topUpCount + 1
        topDragX <- event.x
        topDragY <- event.y
        print("TOP UP x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: primaryClick(their GUI_ButtonEvent: event) <- {
        activePane <- 1
        topClickCount <- topClickCount + 1
        topDragX <- event.x
        topDragY <- event.y
        print("TOP CLICK x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: primaryDblClick(their GUI_ButtonEvent: event) <- {
        activePane <- 1
        topDoubleClickCount <- topDoubleClickCount + 1
        topDragX <- event.x
        topDragY <- event.y
        print("TOP DOUBLE x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: mouseMoved(their GUI_MotionEvent: event) <- {
        if(topDragging){
            topDragMoveCount <- topDragMoveCount + 1
            topDragX <- event.x
            topDragY <- event.y
            requestRedrawAll()
        }
        return(true)
    }

    me bool: keyTyped(their GUI_KeyboardEvent: event) <- {
        activePane <- 1
        topLastKey <- event.keyval
        topKeyTypedCount <- topKeyTypedCount + 1
        print("TOP KEY TYPED key:", topLastKey, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: keyDown(their GUI_KeyboardEvent: event) <- {
        activePane <- 1
        topLastKey <- event.keyval
        topKeyDownCount <- topKeyDownCount + 1
        print("TOP KEY DOWN key:", topLastKey, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: keyUp(their GUI_KeyboardEvent: event) <- {
        activePane <- 1
        topLastKey <- event.keyval
        topKeyUpCount <- topKeyUpCount + 1
        print("TOP KEY UP key:", topLastKey, "\n")
        requestRedrawAll()
        return(true)
    }
}

struct bottomFocusWidget: inherits=DashboardWidget{
    void: requestRedrawAll() <- {
        markDirtyArea(top_canvas, 0, 0, widgetWidth(top_canvas), widgetHeight(top_canvas))
        markDirtyArea(bottom_canvas, 0, 0, widgetWidth(bottom_canvas), widgetHeight(bottom_canvas))
    }

    void: draw(their GUI_ctxt: cr) <- {
        me int: canvasW <- widgetWidth(bottom_canvas)
        me int: canvasH <- widgetHeight(bottom_canvas)

        cr.setRGB(250, 248, 242)
        cr.paintNow()
        if(activePane == 2){
            cr.setRGB(0, 120, 80)
            cr.setLineWidth(5)
        } else {
            cr.setRGB(115, 80, 20)
            cr.setLineWidth(2)
        }
        cr.rectangle(10, 10, canvasW - 20, canvasH - 20)
        cr.strokeNow()

        if(bottomDownCount > 0){
            cr.setRGB(45, 80, 205)
            cr.setLineWidth(3)
            cr.moveTo(bottomDragStartX, bottomDragStartY)
            cr.lineTo(bottomDragX, bottomDragY)
            cr.strokeNow()
            cr.circle(bottomDragX, bottomDragY, 6)
            cr.fillNow()
        }

        cr.setRGB(0, 0, 0)
        cr.setLineWidth(1)
        our fontSpec:: titleFont{"Arial", "21"}
        our fontSpec:: bodyFont{"Arial", "15"}
        renderText(cr, "bottom canvas", titleFont, 28, 42)
        if(activePane == 2){
            renderText(cr, "Focus: yes", bodyFont, 28, 72)
        } else {
            renderText(cr, "Focus: no", bodyFont, 28, 72)
        }
        renderText(cr, "Down/up/click/double: " + toString(bottomDownCount) + " / " + toString(bottomUpCount) + " / " + toString(bottomClickCount) + " / " + toString(bottomDoubleClickCount), bodyFont, 28, 102)
        renderText(cr, "Drag moves: " + toString(bottomDragMoveCount) + "   last: " + toString(bottomDragX) + ", " + toString(bottomDragY), bodyFont, 28, 132)
        renderText(cr, "Key typed/down/up: " + toString(bottomKeyTypedCount) + " / " + toString(bottomKeyDownCount) + " / " + toString(bottomKeyUpCount) + "   last: " + toString(bottomLastKey), bodyFont, 28, 162)
        renderText(cr, "The pane with the green border should receive the next key event.", bodyFont, 28, 198)
    }

    me bool: primaryDn(their GUI_ButtonEvent: event) <- {
        activePane <- 2
        bottomDragging <- true
        bottomDownCount <- bottomDownCount + 1
        bottomDragStartX <- event.x
        bottomDragStartY <- event.y
        bottomDragX <- event.x
        bottomDragY <- event.y
        print("BOTTOM DOWN x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: primaryUp(their GUI_ButtonEvent: event) <- {
        activePane <- 2
        bottomDragging <- false
        bottomUpCount <- bottomUpCount + 1
        bottomDragX <- event.x
        bottomDragY <- event.y
        print("BOTTOM UP x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: primaryClick(their GUI_ButtonEvent: event) <- {
        activePane <- 2
        bottomClickCount <- bottomClickCount + 1
        bottomDragX <- event.x
        bottomDragY <- event.y
        print("BOTTOM CLICK x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: primaryDblClick(their GUI_ButtonEvent: event) <- {
        activePane <- 2
        bottomDoubleClickCount <- bottomDoubleClickCount + 1
        bottomDragX <- event.x
        bottomDragY <- event.y
        print("BOTTOM DOUBLE x:", event.x, " y:", event.y, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: mouseMoved(their GUI_MotionEvent: event) <- {
        if(bottomDragging){
            bottomDragMoveCount <- bottomDragMoveCount + 1
            bottomDragX <- event.x
            bottomDragY <- event.y
            requestRedrawAll()
        }
        return(true)
    }

    me bool: keyTyped(their GUI_KeyboardEvent: event) <- {
        activePane <- 2
        bottomLastKey <- event.keyval
        bottomKeyTypedCount <- bottomKeyTypedCount + 1
        print("BOTTOM KEY TYPED key:", bottomLastKey, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: keyDown(their GUI_KeyboardEvent: event) <- {
        activePane <- 2
        bottomLastKey <- event.keyval
        bottomKeyDownCount <- bottomKeyDownCount + 1
        print("BOTTOM KEY DOWN key:", bottomLastKey, "\n")
        requestRedrawAll()
        return(true)
    }

    me bool: keyUp(their GUI_KeyboardEvent: event) <- {
        activePane <- 2
        bottomLastKey <- event.keyval
        bottomKeyUpCount <- bottomKeyUpCount + 1
        print("BOTTOM KEY UP key:", bottomLastKey, "\n")
        requestRedrawAll()
        return(true)
    }
}

struct GLOBAL{
    their GUI_canvas: drawing_area
    their GUI_canvas: top_canvas
    their GUI_canvas: bottom_canvas
    their topFocusWidget: topPanel
    their bottomFocusWidget: bottomPanel

    me int: activePane <- 0

    me int: topDownCount <- 0
    me int: topUpCount <- 0
    me int: topClickCount <- 0
    me int: topDoubleClickCount <- 0
    me int: topDragMoveCount <- 0
    me bool: topDragging <- false
    me GUI_Scalar: topDragStartX <- 0
    me GUI_Scalar: topDragStartY <- 0
    me GUI_Scalar: topDragX <- 0
    me GUI_Scalar: topDragY <- 0
    me int: topKeyTypedCount <- 0
    me int: topKeyDownCount <- 0
    me int: topKeyUpCount <- 0
    me uint: topLastKey <- 0

    me int: bottomDownCount <- 0
    me int: bottomUpCount <- 0
    me int: bottomClickCount <- 0
    me int: bottomDoubleClickCount <- 0
    me int: bottomDragMoveCount <- 0
    me bool: bottomDragging <- false
    me GUI_Scalar: bottomDragStartX <- 0
    me GUI_Scalar: bottomDragStartY <- 0
    me GUI_Scalar: bottomDragX <- 0
    me GUI_Scalar: bottomDragY <- 0
    me int: bottomKeyTypedCount <- 0
    me int: bottomKeyDownCount <- 0
    me int: bottomKeyUpCount <- 0
    me uint: bottomLastKey <- 0
}

struct APP{
    me void: createAppArea(me GUI_Frame: frame) <- {
        Allocate(topPanel)
        Allocate(bottomPanel)

        top_canvas <- gui.newCanvas()
        top_canvas.setParent(topPanel)
        gui.setWidgetSize(top_canvas, 900, 300)
        topPanel.EventDispatcher.registerWidgetForEventDispatcher(top_canvas, topPanel)
        addToContainer(frame, top_canvas)

        bottom_canvas <- gui.newCanvas()
        bottom_canvas.setParent(bottomPanel)
        gui.setWidgetSize(bottom_canvas, 900, 300)
        bottomPanel.EventDispatcher.registerWidgetForEventDispatcher(bottom_canvas, bottomPanel)
        drawing_area <- bottom_canvas
        addToContainerAndExpand(frame, bottom_canvas)
    }
}
