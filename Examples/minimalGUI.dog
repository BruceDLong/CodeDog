// minimalGUI.dog

LocalBuild: Platform='Local' optimize='speed';
//LinuxBuild: Platform='Linux' CPU='amd64' Lang='CPP' LangVersion='GNU' optimize='speed';
//WindowsBuild: Platform='Windows' CPU='amd64' Lang='CPP' LangVersion='MSVC' optimize='speed';
//SwingBuild: Platform='Java' CPU='JavaVM' Lang='Java' optimize='speed';
//AndroidBuild: Platform='Android' CPU='JavaVM' Lang='Java' optimize='power';
//iPhoneBuild: Platform='IOS' CPU='amd64' Lang='Swift' optimize='speed';
//MacBuild: Platform='MacOS' Lang='Swift' optimize='speed';

Title = "minimalGUI"
FileName = "minimalGUI"
Version = "1.0"
CopyrightMesg = "Public Domain"
Authors = "Bruce Long"
Description = "This is an example of a very minimal GUI"
ProgramOrLibrary = "program"

featuresNeeded = [GUI_ToolKit, Dashboard, List]

LicenseText = `Public Domain`

runCode=``

mainStyle = {}

do makeStyler(mainStyle)
do makeGUI(GUI_Spec)

////////////   A p p l i c a t i o n   a n d   G l o b a l s

struct testWidget: inherits=DashboardWidget{

    void: panel(their GUI_ctxt: cr, me int: x, me int: y, me int: w, me int: h, me string: title) <- {
        our fontSpec:: labelFont{"Arial", "14"}
        cr.setRGB(248, 249, 250)
        cr.rectangle(x, y, w, h)
        cr.fillKeep()
        cr.setRGB(124, 133, 144)
        cr.setLineWidth(1)
        cr.strokeNow()
        cr.setRGB(34, 38, 44)
        renderText(cr, title, labelFont!, x + 12, y + 23)
    }

    void: drawAlignmentMarks(their GUI_ctxt: cr, me int: canvasW, me int: canvasH) <- {
        cr.setRGBA(255, 0, 0, 150)
        cr.setLineWidth(3)
        cr.moveTo(0, 0)
        cr.lineTo(canvasW, canvasH)
        cr.moveTo(canvasW, 0)
        cr.lineTo(0, canvasH)
        cr.rectangle(1, 1, canvasW - 2, canvasH - 2)
        cr.strokeNow()
    }

    void: drawManualGradient(their GUI_ctxt: cr, me int: x, me int: y) <- {
        cr.setRGB(20, 96, 164)
        cr.rectangle(x, y, 18, 74)
        cr.fillNow()
        cr.setRGB(36, 116, 174)
        cr.rectangle(x + 18, y, 18, 74)
        cr.fillNow()
        cr.setRGB(58, 138, 184)
        cr.rectangle(x + 36, y, 18, 74)
        cr.fillNow()
        cr.setRGB(88, 158, 190)
        cr.rectangle(x + 54, y, 18, 74)
        cr.fillNow()
        cr.setRGB(122, 176, 190)
        cr.rectangle(x + 72, y, 18, 74)
        cr.fillNow()
        cr.setRGB(162, 190, 178)
        cr.rectangle(x + 90, y, 18, 74)
        cr.fillNow()
        cr.setRGB(202, 198, 146)
        cr.rectangle(x + 108, y, 18, 74)
        cr.fillNow()
        cr.setRGB(236, 190, 102)
        cr.rectangle(x + 126, y, 18, 74)
        cr.fillNow()
        cr.setRGB(206, 128, 72)
        cr.rectangle(x + 144, y, 18, 74)
        cr.fillNow()
        cr.setRGB(150, 70, 72)
        cr.rectangle(x + 162, y, 18, 74)
        cr.fillNow()
        cr.setRGB(64, 68, 76)
        cr.rectangle(x, y, 180, 74)
        cr.strokeNow()
    }

    void: draw(their GUI_ctxt: cr) <- {
        me int: canvasW <- widgetWidth(drawing_area)
        me int: canvasH <- widgetHeight(drawing_area)
        me int: centerX <- canvasW / 2

        our fontSpec:: titleFont{"Arial", "24"}
        our fontSpec:: bodyFont{"Arial", "15"}
        our fontSpec:: smallFont{"Arial", "12"}

        cr.setRGB(255, 255, 255)
        cr.paintNow()
        drawAlignmentMarks(cr, canvasW, canvasH)

        cr.setRGB(26, 30, 36)
        renderTextCentered(cr, "minimalGUI drawing checks", titleFont, centerX, 34)
        renderTextCentered(cr, "Red diagonals and border should touch the canvas corners.", bodyFont, centerX, 58)

        panel(cr, 30, 82, 260, 150, "text + color")
        cr.setRGB(0, 250, 255)
        renderText(cr, "Hello World!", bodyFont!, 58, 126)
        cr.setRGB(180, 30, 30)
        renderText(cr, "red", smallFont!, 58, 160)
        cr.setRGB(20, 120, 55)
        renderText(cr, "green", smallFont!, 118, 160)
        cr.setRGB(30, 70, 190)
        renderText(cr, "blue", smallFont!, 198, 160)
        cr.setRGB(235, 88, 88)
        cr.rectangle(60, 180, 40, 24)
        cr.fillNow()
        cr.setRGB(74, 186, 112)
        cr.rectangle(124, 180, 40, 24)
        cr.fillNow()
        cr.setRGB(82, 126, 226)
        cr.rectangle(188, 180, 40, 24)
        cr.fillNow()

        panel(cr, 320, 82, 260, 150, "strokes + caps")
        cr.setLineWidth(16)
        cr.setRoundLineCap()
        cr.setRGB(38, 124, 190)
        cr.moveTo(356, 138)
        cr.lineTo(534, 138)
        cr.strokeNow()
        cr.setEdgedLineCap()
        cr.setRGB(210, 82, 82)
        cr.moveTo(356, 184)
        cr.lineTo(534, 184)
        cr.strokeNow()
        cr.setLineWidth(1)
        cr.setRGB(56, 62, 70)
        renderText(cr, "round cap above, edged cap below", smallFont!, 342, 216)

        panel(cr, 610, 82, 260, 150, "circles + rectangles")
        cr.setLineWidth(5)
        cr.setRGB(0, 180, 70)
        cr.circle(700, 155, 42)
        cr.rectangle(792, 112, 18, 86)
        cr.strokeNow()
        cr.setRGB(56, 62, 70)
        renderText(cr, "ellipse and rect should be crisp", smallFont!, 636, 216)

        panel(cr, 30, 260, 260, 170, "fill + alpha")
        cr.setRGB(226, 235, 244)
        cr.rectangle(66, 304, 160, 80)
        cr.fillNow()
        cr.setRGB(134, 146, 160)
        cr.setLineWidth(1)
        cr.moveTo(66, 344)
        cr.lineTo(226, 344)
        cr.moveTo(146, 304)
        cr.lineTo(146, 384)
        cr.strokeNow()
        cr.setLineWidth(6)
        cr.setRGBA(0, 0, 255, 100)
        cr.rectangle(104, 322, 92, 62)
        cr.fillKeep()
        cr.strokeNow()
        cr.setRGB(56, 62, 70)
        renderText(cr, "blue square should be translucent", smallFont!, 58, 414)

        panel(cr, 320, 260, 260, 170, "moveRel + lineRel")
        cr.setLineWidth(4)
        cr.setRGB(72, 102, 180)
        cr.moveTo(364, 330)
        cr.lineRel(36, 0)
        cr.lineRel(0, -34)
        cr.lineRel(50, 0)
        cr.lineRel(0, 58)
        cr.lineRel(62, 0)
        cr.strokeNow()
        cr.setRGB(230, 155, 64)
        cr.moveTo(364, 372)
        cr.lineRel(48, -24)
        cr.lineRel(48, 24)
        cr.lineRel(48, -24)
        cr.lineRel(48, 24)
        cr.strokeNow()
        cr.setRGB(56, 62, 70)
        renderText(cr, "relative path should step cleanly", smallFont!, 344, 414)

        panel(cr, 610, 260, 260, 170, "curveTo + curveRel")
        cr.setLineWidth(4)
        cr.setRGB(154, 74, 164)
        cr.moveTo(648, 352)
        cr.curveTo(688, 288, 754, 414, 834, 326)
        cr.strokeNow()
        cr.setRGB(28, 142, 116)
        cr.moveTo(648, 382)
        cr.curveRel(44, -66, 86, 54, 164, -18)
        cr.strokeNow()
        cr.setRGB(56, 62, 70)
        renderText(cr, "two smooth Bezier curves", smallFont!, 642, 414)

        panel(cr, 30, 458, 260, 170, "offset + scale")
        rotate(cr, 0, 0, 0)
        cr.setOffset(78, 516)
        cr.setScale(1.35, 1.35)
        cr.setRGB(232, 238, 247)
        cr.rectangle(0, 0, 118, 62)
        cr.fillKeep()
        cr.setRGB(55, 94, 155)
        cr.setLineWidth(3)
        cr.strokeNow()
        cr.moveTo(0, 0)
        cr.lineTo(118, 62)
        cr.moveTo(118, 0)
        cr.lineTo(0, 62)
        cr.strokeNow()
        cr.setRGB(18, 40, 72)
        renderText(cr, "scaled", smallFont!, 31, 38)
        restore(cr)
        cr.setRGB(56, 62, 70)
        renderText(cr, "later panels should not be transformed", smallFont!, 54, 612)

        panel(cr, 320, 458, 260, 170, "strokeAndFillPath")
        cr.setRGB(255, 218, 132)
        roundedRectangle(cr, 368, 510, 156, 72, 18)
        cr.strokeAndFillPath()
        cr.setRGB(102, 72, 28)
        renderTextCentered(cr, "filled rounded path", bodyFont, 446, 554)
        cr.setRGB(56, 62, 70)
        renderText(cr, "one call should fill and stroke", smallFont!, 348, 612)

        panel(cr, 610, 458, 260, 170, "gradient reference")
        drawManualGradient(cr, 650, 514)
        cr.setRGB(56, 62, 70)
        renderText(cr, "manual bands; pattern API pending", smallFont!, 626, 612)

        cr.setRGBA(255, 0, 0, 210)
        cr.setLineWidth(3)
        cr.moveTo(0, 0)
        cr.lineTo(canvasW, canvasH)
        cr.moveTo(canvasW, 0)
        cr.lineTo(0, canvasH)
        cr.rectangle(1, 1, canvasW - 2, canvasH - 2)
        cr.strokeNow()
        cr.setEdgedLineCap()
    }

    me bool: primaryClick(their GUI_ButtonEvent: event) <- {
        me GUI_Scalar: eventX <- event!.x
        me GUI_Scalar: eventY <- event!.y
        print("CLICK! (x:", eventX, ", y:", eventY, ")\n")
        return(true)
    }

    me bool: secondaryClick(their GUI_ButtonEvent: event) <- {
        me GUI_Scalar: eventX <- event!.x
        me GUI_Scalar: eventY <- event!.y
        print("SECONDARY CLICK! (x:", eventX, ", y:", eventY, ")\n")
        return(true)
    }
    me bool: primaryUp(their GUI_ButtonEvent: event) <- {
        me GUI_Scalar: eventX <- event!.x
        me GUI_Scalar: eventY <- event!.y
        print("Primary up! (x:", eventX, ", y:", eventY, ")\n")
        return(true)
    }

    me bool: mouseMoved(their GUI_ButtonEvent: event) <- {
        me GUI_Scalar: eventX <- event!.x
        me GUI_Scalar: eventY <- event!.y
        print("MOVE CLICK! (x:", eventX, ", y:", eventY, ")\n")
        return(true)
    }
    me bool: primaryDn(their GUI_ButtonEvent: event) <- {
        me GUI_Scalar: eventX <- event!.x
        me GUI_Scalar: eventY <- event!.y
        print("Primary Down! (x:", eventX, ", y:", eventY, ")\n")
        return(true)
    }
}

struct GLOBAL{
    their GUI_canvas: drawing_area
    their testWidget: drawAnX
    me int: fontSize
}

struct APP{
    me void: createAppArea(me GUI_Frame: frame) <- {
        Allocate(drawAnX)
        drawing_area  <- gui.newCanvas()
        drawing_area.setParent(drawAnX)
        gui.setWidgetSize(drawing_area, 1200, 1200)
        drawAnX!.EventDispatcher.registerWidgetForEventDispatcher(drawing_area, drawAnX)
        addToContainerAndExpand (frame, drawing_area)
    }
}
